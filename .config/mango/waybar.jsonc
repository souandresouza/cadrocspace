// ~/.config/mango/waybar.jsonc
// Barra do mangowm. Usa os modulos mango/* do waybar-git e reaproveita
// o style.css de ~/.config/waybar (que importa colors-waybar.css do ruwall).
{
    "layer": "top",
    "position": "top",
    "height": 34,
    "spacing": 6,
    "margin-top": 6,
    "margin-left": 8,
    "margin-right": 8,
    "reload_style_on_change": true,

    "modules-left": [
        "mango/workspaces",
        "mango/window"
    ],
    "modules-center": [
        "clock"
    ],
    "modules-right": [
        "tray",
        "bluetooth",
        "network",
        "pulseaudio",
        "backlight",
        "battery",
        "custom/recorder",
        "custom/recordertime"
    ],

    "mango/workspaces": {
        "format": "{name}",
        "on-click": "activate",
        "on-click-right": "toggle",
        "hide-empty": true
    },

    "mango/window": {
        "format": "{title}",
        "max-length": 70
    },

    // Cores do calendário em hex fixo: acompanhe a paleta de
    // colors-waybar.css ao trocar o wallpaper.
    "clock": {
        "locale": "pt_BR.UTF-8",
        "format": " {:L%H:%M:%S, %d %B %Y} ",
        "format-alt": " {:L%A, %d %B %Y} ",
        "interval": 1,
        "tooltip-format": "<big>{:L%Y %B}</big>\n<tt><small>{calendar}</small></tt>",
        "calendar": {
            "mode": "month",
            "mode-mon-col": 3,
            "weeks-pos": "right",
            "on-scroll": 1,
            "format": {
                "months":   "<span color='#d3dad2'><b>{}</b></span>",
                "days":     "<span color='#9eaea8'>{}</span>",
                "weeks":    "<span color='#6e7975'><b>W{}</b></span>",
                "weekdays": "<span color='#a1b3a5'><b>{}</b></span>",
                "today":    "<span color='#d3dad2'><b><u>{}</u></b></span>"
            }
        },
        "actions": {
            "on-click-right": "mode",
            "on-scroll-up": "shift_up",
            "on-scroll-down": "shift_down"
        }
    },

    "tray": {
        "icon-size": 16,
        "spacing": 8
    },

    "bluetooth": {
        "format": "{icon}",
        "format-icons": {
            "on": "\uf293",
            "off": "\uf293",
            "disabled": "\uf293"
        },
        "tooltip-format": "{controller_alias}",
        "tooltip-format-connected": "{controller_alias}\n{device_enumerate}",
        "on-click": "blueman-manager"
    },

    "network": {
        "format-wifi": "\uf1eb {essid}",
        "format-ethernet": "\uf0ac {ifname}",
        "format-linked": "\uf0ac {ifname}",
        "format-disconnected": "\uf071 off",
        "tooltip-format-wifi": "{essid} ({signalStrength}%)\n{ipaddr}/{cidr}",
        "tooltip-format-ethernet": "{ifname}\n{ipaddr}/{cidr}",
        "tooltip-format-disconnected": "Desconectado",
        "on-click": "nm-connection-editor"
    },

    "pulseaudio": {
        "format": "{icon} {volume}%",
        "format-muted": "\uf026 muted",
        "format-icons": {
            "default": ["\uf026", "\uf027", "\uf028"]
        },
        "scroll-step": 2,
        "on-click": "pavucontrol"
    },

    "backlight": {
        "format": "\uf185 {percent}%",
        "min-brightness": 1
    },

    "battery": {
        "bat": "BAT1",
        "interval": 30,
        "states": {
            "warning": 30,
            "critical": 15
        },
        "format": "{icon} {capacity}%",
        "format-charging": "\uf0e7 {capacity}%",
        "format-plugged": "\uf0e7 {capacity}%",
        "format-full": "\uf240 {capacity}%",
        "format-icons": ["\uf244", "\uf243", "\uf242", "\uf241", "\uf240"],
        "tooltip-format": "{timeTo}\n{power}W"
    },

    "custom/recorder": {
        "format": "",
        "on-click": "$HOME/.config/scripts/record.sh",
        "tooltip": true,
        "tooltip-format": "Iniciar/parar gravação"
    },

    "custom/recordertime": {
        "exec": "if [ -f /tmp/recording_time ]; then cat /tmp/recording_time; fi",
        "interval": 1,
        "format": "{text}",
        "return-type": "plain",
        "if-file-exists": "/tmp/recording_pid",
        "hide-empty-text": true,
        "on-click": "$HOME/.config/scripts/record.sh",
        "tooltip": true,
        "tooltip-format": "Parar gravação"
    }
}
