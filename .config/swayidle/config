# ~/.config/swayidle/config
# Usado pelo mangowm (exec_once=swayidle -w -C ...).
# Ajuste os tempos em segundos como quiser.

# 5 min sem uso: bloqueia a tela
timeout 300 "$HOME/.config/scripts/lock.sh"

# 15 min sem uso: suspende a sessao (descomente se nao quiser)
timeout 900 'systemctl suspend'

# Bloqueia antes de suspender/hibernar e restaura o DND ao voltar
before-sleep "$HOME/.config/scripts/lock.sh"
after-resume "$HOME/.config/scripts/unlock.sh"

# Destrave da sessao pelo logind
unlock "$HOME/.config/scripts/unlock.sh"
